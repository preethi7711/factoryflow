# FactoryFlow environment variables
# Copy to .env and fill in real values:   cp .env.example .env
# .env is git-ignored. NEVER commit real secrets. Values below are placeholders.

# ---- App -------------------------------------------------------------------
# development | test | production. Controls debug output and CORS strictness.
APP_ENV=development
# All business dates (invoice date, financial year) are computed in this zone.
TZ=Asia/Kolkata
LOG_LEVEL=INFO

# ---- Database (PostgreSQL) -------------------------------------------------
# Used by the postgres container on first start.
POSTGRES_USER=factoryflow
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=factoryflow
# Used by the API. Host "db" = the docker compose service name.
# On a free host, paste the connection string the provider gives you.
DATABASE_URL=postgresql+psycopg://factoryflow:change-me-local-only@db:5432/factoryflow
# Separate database for pytest (created by docker/postgres-init.sql). Tests wipe it.
TEST_DATABASE_URL=postgresql+psycopg://factoryflow:change-me-local-only@db:5432/factoryflow_test

# ---- Auth ------------------------------------------------------------------
# Signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-string
# Short-lived access token, in minutes (a working day = 600).
JWT_EXPIRE_MINUTES=600

# ---- Web / CORS ------------------------------------------------------------
# Comma-separated origins allowed to call the API (the frontend URL).
CORS_ORIGINS=http://localhost:5173
# Read by Vite at build time. Must be the public URL of the API.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ---- Seed ------------------------------------------------------------------
# Password given to every demo login created by the seed script. Dev/demo only.
SEED_DEMO_PASSWORD=demo-change-me
